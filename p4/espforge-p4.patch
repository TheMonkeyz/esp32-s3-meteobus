diff --git a/components/forge_core/Kconfig b/components/forge_core/Kconfig
new file mode 100644
index 0000000..b699de9
--- /dev/null
+++ b/components/forge_core/Kconfig
@@ -0,0 +1,12 @@
+menu "espforge core"
+
+    config FORGE_DIAG_TASK_STATS
+        bool "diag: per-task CPU and stack statistics at each report"
+        default y
+        help
+            The "diag: tasks" and "diag: cpu" lines. They come from uxTaskGetSystemState(), which measures every task's
+            stack with interrupts off: ~6 ms with 25 tasks on an ESP32-P4. A display whose driver restarts each frame
+            from an interrupt (ESP-IDF's MIPI-DSI DPI panel: ~0.9 ms between frames) then misses a frame now and then
+            and flashes: turn this off there.
+
+endmenu
