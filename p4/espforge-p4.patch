                  (unsigned long)cd->exc_pc, bt, cd->exc_bt_info.corrupted ? " (corrupted)" : "");
+#else   // RISC-V (ESP32-P4): no backtrace in the summary, only the registers (riscv32-esp-elf-addr2line PC and RA)
+        ESP_LOGW(TAG, "coredump: last crash in task %s, PC 0x%08lx, RA 0x%08lx, mcause 0x%lx, mtval 0x%08lx",
+                 cd->exc_task, (unsigned long)cd->exc_pc, (unsigned long)cd->ex_info.ra,
+                 (unsigned long)cd->ex_info.mcause, (unsigned long)cd->ex_info.mtval);
+#endif
         esp_core_dump_image_erase();
     }
     free(cd);
diff --git a/components/forge_net/Kconfig b/components/forge_net/Kconfig
index baf35cd..4dab329 100644
--- a/components/forge_net/Kconfig
+++ b/components/forge_net/Kconfig
@@ -1,5 +1,15 @@
 menu "espforge"
 
+    config FORGE_HTTPS_PORT
+        int "Settings page HTTPS port"
+        default 443
+        range 1 65535
+        help
+            The settings page's port on the home network. 443 normally. A board whose Wi-Fi is a co-processor running
+            esp-hosted with "network split" (an ESP32-P4 with an ESP32-C6) hands the host only some ports: 49152-61439
+            and a static list that older co-processor firmware may not give 443 (the Guition JC1060P470C's: the page
+            was unreachable). Addresses the firmware writes (QR codes, redirects, the log) carry the port when not 443.
+
     config FORGE_SETUP_SSID
         string "Setup network name"
         default "Forge-Setup"
